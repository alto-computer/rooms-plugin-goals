{
  "name": "rooms-plugin-goals",
  "version": "0.1.0",
  "private": true,
  "description": "Long-, mid- and short-term goals and a TODO list, as an Alto Rooms plugin.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "package": "bun run build && cd dist && zip -qr ../goals.zip ."
  },
  "dependencies": {
    "@alto-rooms/plugin-sdk": "./vendor/alto-rooms-plugin-sdk-0.7.0.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
